# Copy to .env. Every value is optional; the demo runs on rules alone.

# Telegram tenant bot (npm run telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MIN_REPLY_DELAY_MS=1400
TELEGRAM_MAX_REPLY_DELAY_MS=3200

# Conversational intake through the OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
METRONEST_LLM_ENABLED=true

# Demo shortcut: count "I have sent 3 photos" in web chat as photos. Off by default.
# Web chat cannot attach files; Telegram only ever counts real attachments.
METRONEST_DEMO_TEXT_PHOTOS=0

# Web server
PORT=4173
HOST=127.0.0.1
# METRONEST_STORE_PATH=data/maintenance-store.json
